{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/dashboard", "destination": "/app" },
    { "source": "/dashboard/:path*", "destination": "/app" },
    { "source": "/service", "destination": "/app" },
    { "source": "/connexion", "destination": "/app" },
    { "source": "/inscription", "destination": "/app" },
    { "source": "/reinitialiser-mot-de-passe", "destination": "/app" },
    { "source": "/r/:path*", "destination": "/app" }
  ],
  "headers": [
    { "source": "/dashboard", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/dashboard/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/service", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/connexion", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/inscription", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/reinitialiser-mot-de-passe", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/r/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
