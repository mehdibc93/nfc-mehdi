# Copiez ce fichier en .env.local et remplissez avec les valeurs de votre projet Supabase
# (Project Settings -> API sur supabase.com). Ne jamais mettre la clé "service_role" ici.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Clé PUBLIQUE Stripe (pk_test_... ou pk_live_...) — Developers -> API keys sur dashboard.stripe.com.
# Jamais la clé secrète (sk_...) ici : elle ne va que dans les secrets des Supabase Edge Functions.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
